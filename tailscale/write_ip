if [ "$1" = "able-live" ]
then
  ip=""
  len=0
  while [ "$ip" = "" -o $len -gt 4 ]
  do
    sleep 1
    ip=`hostname -I | cut -d' ' -f 1`
    len=`echo "$ip" | cut -d'.' -f 1 | wc -c`
    if [ "$ip" != "" ]
    then
      echo "ip = $ip  len = $len"
    fi
  done
  while [ ! -d /mem ]
  do
    sleep 1
  done
  ip=`hostname -I | cut -f 1 -d " "`
  file="/mem/able-live.ip"
elif [ "$1" = "teamspeak" ]
then
  if [ "$2" = "" ]
  then
    echo "IP address of Teamspeak server must be supplied"
    exit 1
  fi
  ip="$2"
  file="/mem/teamspeak.ip"
else
  echo "Specify able-live or teamspeak [ip]"
  exit 1
fi

echo -n $ip >$file || exit
echo "$ip written to $file"
chown pi:pi $file
chmod 666 $file

file="/mem/teamspeak.ip"
>$file
chown pi:pi $file
chmod 666 $file
