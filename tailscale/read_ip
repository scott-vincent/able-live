#!/usr/bin/python3
import sys
import os
import time
import socket
import urllib.request
import urllib.error
import subprocess
from subprocess import Popen

if len(sys.argv) > 1 and sys.argv[1] == "able-live":
    url = "https://able-live2.tail518e1b.ts.net/able-live.ip"
elif len(sys.argv) > 1 and sys.argv[1] == "teamspeak":
    url = "https://able-live2.tail518e1b.ts.net/teamspeak.ip"
else:
    print("Specify able-live or teamspeak")
    sys.exit(0)

try:
    ip = urllib.request.urlopen(url).read(32).decode("utf-8")
except urllib.error.HTTPError as e:
    if e.code == 404:
        print("File not found looking for able-live IP address")
    else:
        print(f"Tailscale error: {e.code}")
    sys.exit(0)
except urllib.error.URLError as e:
    print(f"Failed to connect to server with error: {e.reason}")
    sys.exit(0)

if len(ip) < 4:
    print("IP address not found on able-live")
    sys.exit(0)

print(ip, end="")

